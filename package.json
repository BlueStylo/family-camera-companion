{
  "name": "family-camera-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ad-free family camera companion prototype with a public 3D house study.",
  "license": "MIT",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
